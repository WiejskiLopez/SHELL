# Skopiuj do .env.prod i ustaw realne wartości.
# backend.ps1 -Environment prod automatycznie wczytuje .env.prod.
POSTGRES_USER=replace-me
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=shell
POSTGRES_PORT=5432
SHELL_API_KEY=replace-me
# Broker URL must be supplied explicitly; never commit credentials here.
SHELL_EVENTS_BROKER_URL=amqp://replace-host:5672
DEFINITION_SERVICE_URL=https://definition.example.internal
DEFINITION_SERVICE_API_KEY=replace-me
SESSION_SERVICE_URL=https://session.example.internal
SESSION_SERVICE_API_KEY=replace-me
SERVICE_HTTP_TIMEOUT=5

# --- TLS / mTLS (future configuration — disabled unless set) ---
# Server (per usługa): gdy ustawisz cert/key, serwer startuje z TLS.
# `_{SERVICE}_TLS_REQUIRE_CLIENT_CERT=true` wymusza mTLS (wymaga _CA_CERTS).
# Client (per usługa): `{SERVICE}_SERVICE_MTLS_*` określa tożsamość klienta
# (certyfikat + klucz) w wywołaniach wychodzących.
EXECUTION_SERVICE_TLS_CERTFILE=
EXECUTION_SERVICE_TLS_KEYFILE=
EXECUTION_SERVICE_TLS_CA_CERTS=
EXECUTION_SERVICE_TLS_REQUIRE_CLIENT_CERT=false
EXECUTION_SERVICE_MTLS_CA_CERTS=
EXECUTION_SERVICE_MTLS_CERTFILE=
EXECUTION_SERVICE_MTLS_KEYFILE=
DEFINITION_SERVICE_TLS_CERTFILE=
DEFINITION_SERVICE_TLS_KEYFILE=
DEFINITION_SERVICE_TLS_CA_CERTS=
DEFINITION_SERVICE_TLS_REQUIRE_CLIENT_CERT=false
SESSION_SERVICE_TLS_CERTFILE=
SESSION_SERVICE_TLS_KEYFILE=
SESSION_SERVICE_TLS_CA_CERTS=
SESSION_SERVICE_TLS_REQUIRE_CLIENT_CERT=false