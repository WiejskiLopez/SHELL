# Skopiuj do .env.prod i ustaw realne wartości.
# backend.ps1 -Environment prod automatycznie wczytuje .env.prod.
POSTGRES_USER=shell
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shell
POSTGRES_PORT=5432
SHELL_API_KEY=change-me
# Domyślnie broker to rabbit w stacku; dla zewnętrznego brokera nadpisz poniżej.
SHELL_EVENTS_BROKER_URL=amqp://shell:shell@rabbitmq