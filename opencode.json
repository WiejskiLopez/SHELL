{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "git checkout*": "deny",
      "git switch*": "deny",
      "git commit*": "deny",
      "git merge*": "deny",
      "git push*": "deny",
      "git reset*": "deny",
      "git rebase*": "deny",
      "*": "allow"
    }
  }
}
